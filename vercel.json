
{
  "version": 2,
  "name": "hng-ceylon-tours",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "dist/hng-ceylon-tours/browser/**",
        "dist/hng-ceylon-tours/browser/index.csr.html",
        "dist/hng-ceylon-tours/server/**"
      ]
    }
  }
}
