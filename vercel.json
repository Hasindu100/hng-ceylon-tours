
{
  "version": 2,
  "name": "hng-ceylon-tours",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/hng-ceylon-tours/browser",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/hng-ceylon-tours/**"
    }
  }
}
